NODE_ENV=production
HOST=127.0.0.1
PORT=4310
PUBLIC_ORIGIN=https://dev.yytt.com.cn
DATABASE_PATH=/opt/wechat-channels-ai-demo/data/demo.sqlite

SESSION_ENCRYPTION_KEY=
SESSION_COOKIE_SECURE=1
SESSION_COOKIE_MAX_AGE_SECONDS=31536000
PENDING_SESSION_TTL_MS=86400000
QR_TTL_MS=240000
MAX_ACTIVE_SESSIONS=100

WECHAT_BASE_URL=https://channels.weixin.qq.com
WECHAT_TIMEOUT_MS=15000
WECHAT_BROWSER_EXECUTABLE_PATH=/usr/bin/google-chrome-stable
WECHAT_BROWSER_CAPTURE_TIMEOUT_MS=45000
WECHAT_BROWSER_HEADLESS=1
LOGIN_POLL_MS=2000
SYNC_POLL_MS=15000
WORKER_CONCURRENCY=4
MAX_RESPONSE_BYTES=2097152

DEMO_AUTO_REPLY_ENABLED=1
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=doubao-seed-character-260628
ARK_TIMEOUT_MS=45000

# Configure only on the DEV host allowed by the recruitment service.
FUNNEL_BASE_URL=
FUNNEL_TIMEOUT_MS=45000
